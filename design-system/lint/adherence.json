{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "scratch/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Figtree, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|leading|title|subtitle|trailing|muted|onClick|href|key|ref|className|style|children)$/]",
        "message": "<ActionRow> doesn't accept that prop. Declared props: icon, leading, title, subtitle, trailing, muted, onClick, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|time|onMenu|key|ref|className|style|children)$/]",
        "message": "<ActivityCard> doesn't accept that prop. Declared props: icon, title, time, onMenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtifactCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|meta|onOpen|onMenu|key|ref|className|style|children)$/]",
        "message": "<ArtifactCard> doesn't accept that prop. Declared props: kind, title, meta, onOpen, onMenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtifactCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:doc|sheet|sequence|list)$/]",
        "message": "<ArtifactCard> kind must be one of 'doc' | 'sheet' | 'sequence' | 'list'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|round|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, round."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|dot|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, dot, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|block|href|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, block, href, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'soft' | 'ghost' | 'danger'."
